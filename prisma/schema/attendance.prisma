model attendance {
  id Int @id @default(autoincrement())

  date        DateTime        @db.Date
  time        DateTime        @db.Time
  type        attendance_type
  description String?

  company_id Int
  worker_id  Int
  branch_id  Int
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  company company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_company_id_foreign")
  worker  worker  @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_worker_id_foreign")
  branch  filial  @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_branch_id_foreign")

  @@unique([worker_id, date])
  @@index([company_id])
}

enum attendance_type {
  check_in
  check_out
}
