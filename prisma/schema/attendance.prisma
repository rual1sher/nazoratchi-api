model attendance {
  id Int @id @default(autoincrement())

  date         DateTime  @db.Date
  arrival_at   DateTime? @db.Timestamptz // prishol
  departure_at DateTime? @db.Timestamptz // ushol

  worker_id  Int
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  worker worker @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "attendance_worker_id_foreign")

  @@unique([worker_id, date])
}
