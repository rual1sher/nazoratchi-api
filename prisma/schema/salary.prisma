model salary {
  id Int @id @default(autoincrement())

  company_id Int
  amount     Int
  type       salary_type
  start_date DateTime    @db.Timestamptz(0)
  fixed      Boolean     @default(false)
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  deleted_at DateTime?

  company company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "salary_company_id_foreign")
  workers worker[]

  @@index([company_id])
}

enum salary_type {
  monthly
  hourly
  project
}
