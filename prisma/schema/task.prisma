model task {
  id Int @id @default(autoincrement())

  company_id  Int
  name        String      @db.VarChar(255)
  description String?     @db.Text
  priority    Int         @default(2) // 1 = low, 2 = medium, 3 = high
  status      task_status @default(created)

  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  company company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "task_company_id_foreign")
  workers worker[]

  @@index([company_id])
}

enum task_status {
  created
  inProgress
  done
}
