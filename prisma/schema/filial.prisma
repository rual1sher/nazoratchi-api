model filial {
  id Int @id @default(autoincrement())

  name        String    @db.VarChar(255)
  address     String    @db.VarChar(255)
  radius      Int
  coordinates String
  company_id  Int
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  deleted_at  DateTime?

  company         company          @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "filial_company_id_foreign")
  worker          worker[]
  terminals       terminal[]
  attendance      attendance[]
  holiday_filials holiday_filial[]
}
