model payment {
  id Int @id @default(autoincrement())

  company_id Int
  amount     Int
  type       payment_type
  date       DateTime     @db.Date
  comment    String?
  worker_id  Int
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now()) @updatedAt
  deleted_at DateTime?

  company company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_company_id_foreign")
  worker  worker  @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_worker_id_foreign")

  @@index([company_id])
}

enum payment_type {
  income
  bonus
  penalty
}
