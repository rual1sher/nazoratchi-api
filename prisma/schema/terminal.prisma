model terminal {
    id Int @id @default(autoincrement())

    name        String @db.VarChar(255)
    unique_id   String @unique @db.VarChar(255)
    mac_address String @unique @db.VarChar(255)
    branch_id   Int
    company_id  Int

    created_at DateTime  @default(now())
    updated_at DateTime  @default(now()) @updatedAt
    deleted_at DateTime?

    company company @relation(fields: [company_id], references: [id], onDelete: Cascade, map: "terminal_company_id_foreign")
    branch  filial  @relation(fields: [branch_id], references: [id], onDelete: Cascade, map: "terminal_branch_id_foreign")

    @@index([branch_id])
}
