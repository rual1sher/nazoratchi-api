model worker_schedule {
  id Int @id @default(autoincrement())

  company_id     Int
  name           String
  type           worker_schedule_type @default(adaptive)
  starts_at      DateTime             @db.Timestamp()
  days_frequency Int
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt
  deleted_at     DateTime?

  company company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "worker_schedule_company_id_foreign")
  workers worker[]
  days    day[]

  @@index([company_id])
}

enum worker_schedule_type {
  adaptive
  free
}
